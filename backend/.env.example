# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=eventura
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/eventura"

# Server
PORT=5000
NODE_ENV=development

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300
