FROM node:20-alpine

WORKDIR /app

# Install deps first for better layer caching
COPY package.json package-lock.json ./
RUN npm ci

# Prisma needs the schema to generate the client
COPY prisma ./prisma
RUN npx prisma generate

# App source
COPY tsconfig.json prisma.config.ts ./
COPY src ./src
COPY index.js ./

EXPOSE 5000

CMD ["node", "index.js"]